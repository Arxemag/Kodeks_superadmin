DB_URL=
PG_HOST=localhost
PG_PORT=5432
PG_USERNAME=user
PG_PASSWORD=password
PG_DATABASE=test_base
POOL_SIZE=10
POOL_TIMEOUT=30
CATALOG_LOCK_TIMEOUT=30
# Имена таблиц БД (опционально; по умолчанию reg_services, department_service_mapping)
# DB_TABLE_REG_SERVICES=reg_services
# DB_TABLE_DEPARTMENT_MAPPING=department_service_mapping

ADMIN_LOGIN=kodeks
ADMIN_PASSWORD=skedoks

HTTP_TIMEOUT=10
LOG_LEVEL=INFO
# For deep troubleshooting set: LOG_LEVEL=DEBUG
# Порт HTTP-сервера Auth API (main.py)
PORT=8000
# AUTH_SERVICE_URL — куда воркер ходит за куками админа по HTTP.
# ВНИМАНИЕ: в docker-compose это ИМЯ СЕРВИСА (http://auth-api:8000), а НЕ 127.0.0.1
# (для воркера 127.0.0.1 — его собственный контейнер, где API нет -> AUTH_SERVICE_UNAVAILABLE).
# В compose уже задано через environment воркера; здесь — для запуска без докера.
AUTH_SERVICE_URL=http://127.0.0.1:8000

# Kafka. Для Docker: брокер на хосте — host.docker.internal:9092 (Windows/Mac)
# Единый worker (main_unified_worker.py): одна группа KAFKA_GROUP_ID, подписка на все топики.
KAFKA_BROKER=127.0.0.1:9092
KAFKA_BOOTSTRAP_SERVERS=

# Одна consumer group для всех топиков (unified worker)
KAFKA_GROUP_ID=superadmin-workers

# Топики (разные, обрабатываются одним воркером по record.topic)
KAFKA_CREATE_TOPIC=create-user
KAFKA_UPDATE_TOPIC=update-user
KAFKA_UPDATE_DEPARTMENTS_TOPIC=update-user-departments
KAFKA_DLQ_TOPIC=users-dlq
KAFKA_INIT_COMPANY_TOPIC=init_company
KAFKA_INIT_COMPANY_DLQ_TOPIC=init_company-dlq
KAFKA_ENABLE_REG_COMPANY_TOPIC=enable_reg_company
KAFKA_DISABLE_REG_COMPANY_TOPIC=disable_reg_company
KAFKA_REG_COMPANY_DLQ_TOPIC=reg-company-dlq

# Уточнение кабинета по опроснику (вход correct-cabinet -> выход cabinet-corrected)
# ВНИМАНИЕ: на брокере топик через ДЕФИС — correct-cabinet (не подчёркивание!)
KAFKA_CORRECT_CABINET_TOPIC=correct-cabinet
KAFKA_CABINET_CORRECTED_TOPIC=cabinet-corrected
KAFKA_CORRECT_CABINET_DLQ_TOPIC=correct-cabinet-dlq
# CORRECT_CABINET_METRICS_PORT=9104   # только для отдельного процесса
# Первый прогон: true — только план в лог, БЕЗ удаления и cabinet-corrected
CORRECT_CABINET_DRY_RUN=false

KAFKA_MAX_CONCURRENCY=200
KAFKA_POLL_TIMEOUT_MS=500
KAFKA_MAX_BATCH=500

# Долговечный журнал единого worker (namespace сохранять неизменным между запусками).
INTEGRATION_SOURCE_NAMESPACE=kodeks-platform
INTEGRATION_EXECUTOR_CONCURRENCY=2
INTEGRATION_MAX_PENDING=10000
INTEGRATION_POLL_SECONDS=0.5
INTEGRATION_RETRY_ATTEMPTS=5
INTEGRATION_RETRY_BASE_SECONDS=1.0
INTEGRATION_RETRY_MAX_SECONDS=60.0
INTEGRATION_EVENT_DEADLINE_SECONDS=3600.0
INTEGRATION_SHUTDOWN_SECONDS=30.0

USERS_RETRY_ATTEMPTS=3
USERS_RETRY_BASE_DELAY=0.2
USERS_RETRY_MAX_DELAY=3.0

# Метрики единого воркера (порт 9100)
UNIFIED_WORKER_METRICS_PORT=9100
# На /metrics worker сообщает unified_worker_ready: 1 после запуска Kafka и pipeline, иначе 0.

# Hard timeout for whole /auth/login operation
AUTH_HARD_TIMEOUT=30
# Устаревший совместимый параметр; DEBUG больше не меняет таймаут авторизации.
AUTH_HARD_TIMEOUT_DEBUG=20
